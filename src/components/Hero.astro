---
---

<section id="top" class="hero scanlines">
	<div class="hero-grid" aria-hidden="true"></div>
	<div class="container hero-inner">
		<p class="mono-label eyebrow">// NOW IN PRIVATE BETA</p>
		<h1 class="glitch" data-text="Neural Napper">Neural Napper</h1>
		<p class="tagline">Your AI attends the meeting. You attend the nap.</p>
		<p class="hero-sub">
			Neural Napper joins your video calls, nods at the right moments, and writes up the notes
			while you catch up on sleep. Wake up to a clean summary and a calendar that didn't eat your
			afternoon.
		</p>
		<div class="hero-actions">
			<a href="#waitlist" class="btn btn-primary clipped">Join the waitlist</a>
			<a href="#features" class="btn btn-secondary clipped">See how it works</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(4rem, 10vw, 8rem) clamp(5rem, 10vw, 8rem);
		background: radial-gradient(circle at 50% -10%, rgba(45, 27, 78, 0.9), var(--void) 60%);
	}

	.hero-grid {
		position: absolute;
		inset: auto 0 0 0;
		height: 45%;
		background-image: linear-gradient(rgba(5, 217, 232, 0.25) 1px, transparent 1px),
			linear-gradient(90deg, rgba(5, 217, 232, 0.25) 1px, transparent 1px);
		background-size: 48px 48px;
		-webkit-mask-image: linear-gradient(to top, black, transparent);
		mask-image: linear-gradient(to top, black, transparent);
		transform: perspective(300px) rotateX(55deg);
		transform-origin: bottom;
		opacity: 0.6;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: 760px;
	}

	.eyebrow {
		color: var(--neon-pink);
		margin-bottom: 1.25rem;
	}

	.hero h1 {
		font-size: clamp(2.6rem, 7vw, 4.5rem);
		color: var(--text-primary);
		text-shadow: var(--glow-cyan);
	}

	.tagline {
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2.4vw, 1.4rem);
		color: var(--electric-cyan);
		margin-bottom: 1.25rem;
	}

	.hero-sub {
		max-width: 56ch;
		font-size: 1.05rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2rem;
	}
</style>
