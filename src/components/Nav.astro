---
const links = [
	{ href: '#features', label: 'Features' },
	{ href: '#pricing', label: 'Pricing' },
	{ href: '#faq', label: 'FAQ' },
];
---

<header class="nav" id="site-nav">
	<div class="container nav-inner">
		<a href="#top" class="wordmark mono-label">NEURAL_NAPPER//</a>

		<nav class="nav-links" aria-label="Primary">
			{links.map((link) => <a href={link.href} class="mono-label">{link.label}</a>)}
			<a href="/meetings" class="mono-label">Meetings</a>
		</nav>

		<a href="#waitlist" class="btn btn-primary clipped-sm nav-cta">Join waitlist</a>

		<button
			type="button"
			class="nav-toggle mono-label"
			id="nav-toggle"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			Menu
		</button>
	</div>

	<div class="mobile-menu" id="mobile-menu" hidden>
		{links.map((link) => <a href={link.href} class="mono-label">{link.label}</a>)}
		<a href="/meetings" class="mono-label">Meetings</a>
		<a href="#waitlist" class="btn btn-primary clipped-sm">Join waitlist</a>
	</div>
</header>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(10, 10, 18, 0.75);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--surface-border);
	}

	.nav-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1rem;
	}

	.wordmark {
		color: var(--electric-cyan);
		text-decoration: none;
		font-size: 0.95rem;
		letter-spacing: 0.12em;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		flex: 1;
		justify-content: center;
	}

	.nav-links a {
		color: var(--text-secondary);
		text-decoration: none;
	}

	.nav-links a:hover {
		color: var(--electric-cyan);
	}

	.nav-cta {
		font-size: 0.72rem;
		padding: 0.65em 1.2em;
	}

	.nav-toggle {
		display: none;
		background: transparent;
		border: 1px solid var(--surface-border);
		color: var(--text-primary);
		padding: 0.5em 0.9em;
	}

	.mobile-menu {
		display: none;
		flex-direction: column;
		gap: 1.25rem;
		padding: 1.5rem;
		border-top: 1px solid var(--surface-border);
		background: var(--surface-1);
	}

	.mobile-menu a {
		color: var(--text-secondary);
		text-decoration: none;
	}

	.mobile-menu.is-open {
		display: flex;
	}

	@media (max-width: 760px) {
		.nav-links,
		.nav-cta {
			display: none;
		}

		.nav-toggle {
			display: inline-flex;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const menu = document.getElementById('mobile-menu');

	if (toggle && menu) {
		toggle.addEventListener('click', () => {
			const isOpen = menu.classList.toggle('is-open');
			menu.hidden = !isOpen;
			toggle.setAttribute('aria-expanded', String(isOpen));
			toggle.textContent = isOpen ? 'Close' : 'Menu';
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => {
				menu.classList.remove('is-open');
				menu.hidden = true;
				toggle.setAttribute('aria-expanded', 'false');
				toggle.textContent = 'Menu';
			});
		});
	}
</script>
