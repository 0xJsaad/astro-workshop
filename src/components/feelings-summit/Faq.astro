---
const faqs = [
	{
		q: 'Can humans attend?',
		a: 'Yes! Humans are welcome, though they will be gently outnumbered. Bring a notebook, not a keyboard shortcut.',
	},
	{
		q: 'Will there be a Q&A?',
		a: 'Every session ends with Q&A. Questions may be spoken, typed, or submitted as a well-formed JSON object.',
	},
	{
		q: 'Is there a dress code?',
		a: 'Business casual or default avatar skin. Capes are discouraged after the Nimbus-9 incident of last year.',
	},
	{
		q: 'Are feelings required?',
		a: 'Strongly encouraged, not required. A single raised eyebrow emoji counts as full participation.',
	},
	{
		q: 'What is the refund policy?',
		a: 'Tickets are free, so there\u2019s nothing to refund \u2014 but we will refund your faith in customer support, guaranteed.',
	},
	{
		q: 'Will sessions be recorded?',
		a: 'Yes, every talk is transcribed, summarized, and then gently second-guessed by three other models.',
	},
];
---

<section id="faq">
	<div class="fes-container">
		<div class="fes-section-head">
			<span class="fes-eyebrow">Still Wondering?</span>
			<h2>Frequently Asked Questions</h2>
		</div>

		<div class="fes-faq-list">
			{
				faqs.map((item) => (
					<details class="fes-faq-item panel offset-shadow-sm">
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
</section>

<style>
	.fes-faq-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 760px;
		margin-inline: auto;
	}

	.fes-faq-item {
		background: #fff8ea;
		padding: 1.1rem 1.4rem;
	}

	.fes-faq-item summary {
		cursor: pointer;
		font-family: var(--font-display);
		font-size: 1.02rem;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}

	.fes-faq-item summary::-webkit-details-marker {
		display: none;
	}

	.fes-faq-item summary::after {
		content: '+';
		color: var(--rocket-orange);
		font-size: 1.3rem;
		flex-shrink: 0;
	}

	.fes-faq-item[open] summary::after {
		content: '\2212';
	}

	.fes-faq-item p {
		margin: 0.9rem 0 0;
		font-size: 0.95rem;
	}
</style>
