---
interface Props {
	color?: string;
	size?: number;
	points?: number;
	class?: string;
	ariaLabel?: string;
}

const { color = 'var(--sunshine)', size = 120, points = 12, class: className, ariaLabel } = Astro.props;

const outerR = 50;
const innerR = 24;
const step = Math.PI / points;
const coords: string[] = [];
for (let i = 0; i < points * 2; i++) {
	const r = i % 2 === 0 ? outerR : innerR;
	const angle = i * step - Math.PI / 2;
	const x = (50 + r * Math.cos(angle)).toFixed(2);
	const y = (50 + r * Math.sin(angle)).toFixed(2);
	coords.push(`${x},${y}`);
}
const pointsAttr = coords.join(' ');
---

<svg
	class={`starburst ${className ?? ''}`}
	width={size}
	height={size}
	viewBox="0 0 100 100"
	role={ariaLabel ? 'img' : 'presentation'}
	aria-label={ariaLabel}
	aria-hidden={ariaLabel ? undefined : 'true'}
>
	<polygon points={pointsAttr} fill={color} stroke="var(--deep-space)" stroke-width="2" stroke-linejoin="round" />
</svg>
