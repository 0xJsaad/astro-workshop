---
interface Props {
	face: 'orange' | 'teal' | 'sunshine' | 'cream';
	size?: number;
}

const { face, size = 96 } = Astro.props;

const fills: Record<Props['face'], string> = {
	orange: 'var(--rocket-orange)',
	teal: 'var(--teal-ray)',
	sunshine: 'var(--sunshine)',
	cream: '#fff8ea',
};

const fill = fills[face];
---

<svg
	width={size}
	height={size}
	viewBox="0 0 100 100"
	role="presentation"
	aria-hidden="true"
>
	<!-- antenna -->
	<line x1="50" y1="6" x2="50" y2="18" stroke="var(--deep-space)" stroke-width="3" stroke-linecap="round" />
	<circle cx="50" cy="6" r="4" fill="var(--sunshine)" stroke="var(--deep-space)" stroke-width="2" />
	<!-- head -->
	<rect x="16" y="18" width="68" height="60" rx="18" fill={fill} stroke="var(--deep-space)" stroke-width="3" />
	<!-- eyes -->
	<circle cx="38" cy="46" r="6" fill="var(--deep-space)" />
	<circle cx="62" cy="46" r="6" fill="var(--deep-space)" />
	<!-- smile -->
	<path d="M36 60 Q50 72 64 60" fill="none" stroke="var(--deep-space)" stroke-width="3.5" stroke-linecap="round" />
	<!-- ears -->
	<rect x="6" y="38" width="10" height="18" rx="4" fill={fill} stroke="var(--deep-space)" stroke-width="3" />
	<rect x="84" y="38" width="10" height="18" rx="4" fill={fill} stroke="var(--deep-space)" stroke-width="3" />
</svg>
