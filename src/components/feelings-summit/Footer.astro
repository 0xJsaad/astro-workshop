---
import Starburst from './Starburst.astro';

const year = new Date().getFullYear();
---

<footer class="fes-footer">
	<div class="fes-container fes-footer-divider" aria-hidden="true">
		<Starburst color="var(--teal-ray)" size={36} points={8} />
		<Starburst color="var(--rocket-orange)" size={48} points={10} />
		<Starburst color="var(--sunshine)" size={36} points={8} />
	</div>

	<div class="fes-container fes-footer-inner">
		<span class="fes-wordmark">Feelings.exe</span>
		<p class="fes-copyright">&copy; {year} Feelings.exe Summit. All rights reserved (and so are your emotions).</p>
	</div>
</footer>

<style>
	.fes-footer {
		border-top: 3px solid var(--deep-space);
		padding-block: 2rem;
		background: var(--cream-paper);
	}

	.fes-footer-divider {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		margin-bottom: 1.5rem;
	}

	.fes-footer-inner {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
		justify-content: space-between;
	}

	.fes-wordmark {
		font-family: var(--font-display);
		font-size: 1rem;
	}

	.fes-copyright {
		font-size: 0.8rem;
		margin: 0;
	}
</style>
