---
---

<section id="register" class="fes-register">
	<div class="fes-container">
		<div class="fes-section-head fes-register-head">
			<span class="fes-eyebrow">Save Your Spot</span>
			<h2>Register</h2>
			<p>Tickets are free. Feelings are mandatory.</p>
		</div>

		<form id="fes-register-form" class="fes-register-form panel offset-shadow" novalidate>
			<div class="fes-field">
				<label for="fes-name">Name</label>
				<input type="text" id="fes-name" name="name" autocomplete="name" required />
				<p class="field-error" id="fes-name-error" role="alert"></p>
			</div>

			<div class="fes-field">
				<label for="fes-email">Work email</label>
				<input type="email" id="fes-email" name="email" autocomplete="email" required />
				<p class="field-error" id="fes-email-error" role="alert"></p>
			</div>

			<div class="fes-field">
				<label for="fes-ticket">Ticket type</label>
				<select id="fes-ticket" name="ticketType" autocomplete="off" required>
					<option value="">Select a ticket type&hellip;</option>
					<option value="human">Human</option>
					<option value="assistant">Assistant</option>
					<option value="complicated">It's Complicated</option>
				</select>
				<p class="field-error" id="fes-ticket-error" role="alert"></p>
			</div>

			<button type="submit" class="btn btn-primary fes-register-submit" id="fes-register-submit">
				Register for free
			</button>

			<p class="fes-register-status" id="fes-register-status" aria-live="polite"></p>
		</form>
	</div>
</section>

<style>
	.fes-register-head {
		text-align: center;
		margin-inline: auto;
	}

	.fes-register-form {
		max-width: 520px;
		margin-inline: auto;
		padding: clamp(1.75rem, 4vw, 2.5rem);
		background: #fff8ea;
	}

	.fes-field {
		margin-bottom: 1.25rem;
	}

	.fes-register-submit {
		width: 100%;
		margin-top: 0.5rem;
	}

	.fes-register-status {
		margin: 1rem 0 0;
		font-weight: 700;
		min-height: 1.4em;
	}

	.fes-register-status[data-state='success'] {
		color: #136651;
	}

	.fes-register-status[data-state='error'] {
		color: #9c3b17;
	}
</style>

<script>
	const form = document.getElementById('fes-register-form') as HTMLFormElement | null;
	const submitBtn = document.getElementById('fes-register-submit') as HTMLButtonElement | null;
	const status = document.getElementById('fes-register-status');

	const fields = {
		name: {
			input: document.getElementById('fes-name') as HTMLInputElement | null,
			error: document.getElementById('fes-name-error'),
		},
		email: {
			input: document.getElementById('fes-email') as HTMLInputElement | null,
			error: document.getElementById('fes-email-error'),
		},
		ticketType: {
			input: document.getElementById('fes-ticket') as HTMLSelectElement | null,
			error: document.getElementById('fes-ticket-error'),
		},
	};

	const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	function setError(field: keyof typeof fields, message: string) {
		const { input, error } = fields[field];
		if (!input || !error) return;
		error.textContent = message;
		input.setAttribute('aria-invalid', message ? 'true' : 'false');
	}

	function validate(): boolean {
		let valid = true;

		const name = fields.name.input?.value.trim() ?? '';
		if (!name) {
			setError('name', 'Please tell us what to call you.');
			valid = false;
		} else {
			setError('name', '');
		}

		const email = fields.email.input?.value.trim() ?? '';
		if (!email) {
			setError('email', 'A work email is required.');
			valid = false;
		} else if (!emailPattern.test(email)) {
			setError('email', 'That doesn\u2019t look like a valid email address.');
			valid = false;
		} else {
			setError('email', '');
		}

		const ticketType = fields.ticketType.input?.value ?? '';
		if (!ticketType) {
			setError('ticketType', 'Pick the ticket type that fits you best.');
			valid = false;
		} else {
			setError('ticketType', '');
		}

		return valid;
	}

	if (form && submitBtn && status) {
		form.addEventListener('submit', async (event) => {
			event.preventDefault();

			if (!validate()) {
				status.dataset.state = 'error';
				status.textContent = 'Please fix the highlighted fields and try again.';
				return;
			}

			submitBtn.disabled = true;
			submitBtn.textContent = 'Registering\u2026';
			status.dataset.state = '';
			status.textContent = '';

			const payload = {
				name: fields.name.input?.value.trim(),
				email: fields.email.input?.value.trim(),
				ticketType: fields.ticketType.input?.value,
			};

			try {
				// NOTE: This project is configured for static output with no server
				// adapter installed (no @astrojs/node, @astrojs/vercel, etc.), so a
				// real `/api/register` endpoint would break `astro build`. Until an
				// adapter is added, this is a clearly-commented mock submission:
				// it simulates network latency and always succeeds.
				// TODO: connect to real storage/ESP once a server adapter is
				// configured (see src/pages/api/ for a real POST /api/register
				// handler once that's in place).
				await new Promise<void>((resolve) => setTimeout(resolve, 600));
				console.log('[mock] Feelings.exe Summit registration submitted:', payload);

				status.dataset.state = 'success';
				status.textContent = 'You\u2019re in! A confirmation beep-boop is on its way to your inbox.';
				form.reset();
			} catch (err) {
				status.dataset.state = 'error';
				status.textContent =
					err instanceof Error ? err.message : 'We couldn\u2019t register you just now. Please try again.';
			} finally {
				submitBtn.disabled = false;
				submitBtn.textContent = 'Register for free';
			}
		});
	}
</script>
