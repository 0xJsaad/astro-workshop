---
import Starburst from './Starburst.astro';
import Boomerang from './Boomerang.astro';
import Rocket from './Rocket.astro';
---

<section id="top" class="fes-hero">
	<div class="fes-hero-decor" aria-hidden="true">
		<Starburst class="fes-hero-starburst" color="var(--sunshine)" size={520} points={14} />
		<Boomerang class="fes-hero-boomerang-l" color="var(--teal-ray)" size={90} rotation={-20} />
		<Boomerang class="fes-hero-boomerang-r" color="var(--rocket-orange)" size={70} rotation={160} />
		<Rocket class="fes-hero-rocket" size={90} rotation={-10} />
	</div>

	<div class="fes-container fes-hero-inner">
		<span class="sticker fes-hero-sticker">Keynote inside! ✦</span>

		<h1>Feelings.exe Summit</h1>
		<p class="fes-tagline">One day. Many robots. Zero judgment.</p>

		<p class="fes-hero-date">
			<!-- TODO: confirm date/venue -->
			Saturday, March 14, 2027 · Retro Rocket Convention Hall
		</p>

		<div class="fes-hero-actions">
			<a href="#register" class="btn btn-primary">Register for free</a>
			<a href="#agenda" class="btn btn-ghost">See the agenda</a>
		</div>
	</div>
</section>

<style>
	.fes-hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(4rem, 10vw, 7rem) clamp(5rem, 10vw, 8rem);
	}

	.fes-hero-decor {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}

	.fes-hero-starburst {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -52%);
		opacity: 0.9;
	}

	.fes-hero-boomerang-l {
		position: absolute;
		top: 14%;
		left: 6%;
	}

	.fes-hero-boomerang-r {
		position: absolute;
		bottom: 12%;
		right: 8%;
	}

	.fes-hero-rocket {
		position: absolute;
		top: 8%;
		right: 10%;
	}

	.fes-hero-inner {
		position: relative;
		z-index: 1;
		max-width: 760px;
		margin-inline: auto;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.fes-hero-sticker {
		margin-bottom: 1.5rem;
	}

	.fes-hero h1 {
		font-size: clamp(2.4rem, 8vw, 4.8rem);
		color: #636240;
	}

	.fes-tagline {
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2.6vw, 1.5rem);
		color: var(--deep-space);
		margin-bottom: 1rem;
	}

	.fes-hero-date {
		font-weight: 700;
		font-size: 1.05rem;
		margin-bottom: 2rem;
	}

	.fes-hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		justify-content: center;
	}

	@media (max-width: 760px) {
		.fes-hero-boomerang-l,
		.fes-hero-boomerang-r,
		.fes-hero-rocket {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.fes-hero-sticker {
			transform: none;
		}
	}
</style>
